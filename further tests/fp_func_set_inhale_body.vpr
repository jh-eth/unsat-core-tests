// Set[Int]/inhale test with one used and one unused precondition.
// 1 in s determines the asserted result. 2 in t is required only to admit
// the call. The exact equality t == Set(2) establishes the unused condition.

function set_inhale_body(s: Set[Int], t: Set[Int], u: Set[Int]): Int
  requires 1 in s && 2 in t
{
  1 in s ? 1 : 0
}

method caller()
{
  var s: Set[Int]
  var t: Set[Int]
  var u: Set[Int]
  inhale t == Set(2)
  inhale u == t
  inhale 1 in s
  assert set_inhale_body(s, t, u) == 1
}
